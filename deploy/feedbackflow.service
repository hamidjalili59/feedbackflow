[Unit]
Description=FeedbackFlow Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=feedbackflow
Group=feedbackflow
WorkingDirectory=/opt/feedbackflow/current
EnvironmentFile=/opt/feedbackflow/.env
ExecStart=/opt/feedbackflow/current/feedbackflow-server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/opt/feedbackflow

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
