# ---- Network ----------------------------------------------------------------
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8080

# ---- Database ---------------------------------------------------------------
# Replace STRONG_PASSWORD_HERE with the password you set when creating the DB.
# Use a long random value - generate with:  openssl rand -base64 32
DATABASE_URL=postgres://feedbackflow:STRONG_PASSWORD_HERE@localhost:5432/feedbackflow
DATABASE_MAX_CONNECTIONS=20

# ---- JWT --------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes
JWT_ISSUER=feedbackflow-server
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---- CORS -------------------------------------------------------------------
# Comma separated list of origins that may call /api/v1.
CORS_ALLOWED_ORIGINS=https://your-domain.example

# ---- Flutter web ------------------------------------------------------------
# The release bundle ships a `web/` folder next to the binary, so the default
# (./web) works out of the box. Override only if you serve the web client from
# a different path.
# FLUTTER_WEB_DIST_DIR=./web

# ---- Migrations -------------------------------------------------------------
RUN_MIGRATIONS=true

# ---- Logging ----------------------------------------------------------------
RUST_LOG=feedbackflow_server=info,tower_http=info,sqlx=warn
