# ----- Secrets & local environment -----
.env
.env.local
.env.*.local

# ----- Editor / IDE -----
.idea/
.vscode/
*.iml
*.iws
*.ipr

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
flutter_web_*.log
flutter_web_*.err.log

# =============================================================================
# server/ (Rust)
# =============================================================================
server/target/
server/.cargo/

# =============================================================================
# client/ (Flutter)
# =============================================================================
# Build / cache
client/build/
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.pub-cache/
client/.pub/
client/coverage/
client/doc/api/
client/migrate_working_dir/

# Symbolication / obfuscation
client/app.*.symbols
client/app.*.map.json

# Android
client/android/.gradle/
client/android/.kotlin/
client/android/captures/
client/android/local.properties
client/android/app/debug
client/android/app/profile
client/android/app/release
client/android/app/.cxx
client/**/.gradle/

# iOS
client/ios/Pods/
client/ios/.symlinks/
client/ios/Flutter/.last_build_id
client/ios/Flutter/Flutter.framework
client/ios/Flutter/Flutter.podspec
client/ios/Flutter/Generated.xcconfig
client/ios/Flutter/ephemeral/
client/ios/Flutter/flutter_export_environment.sh

# macOS
client/macos/Pods/
client/macos/Flutter/ephemeral/

# Linux / Windows desktop builds
client/linux/flutter/ephemeral/
client/windows/flutter/ephemeral/
client/windows/flutter/generated_plugin_registrant.cc
client/windows/flutter/generated_plugin_registrant.h
client/windows/flutter/generated_plugins.cmake
client/linux/flutter/generated_plugin_registrant.cc
client/linux/flutter/generated_plugin_registrant.h
client/linux/flutter/generated_plugins.cmake
client/macos/Flutter/GeneratedPluginRegistrant.swift

# Bundled font binaries (downloaded by scripts/download_vazirmatn_fonts.*)
client/assets/fonts/*.ttf
client/assets/fonts/*.otf

# Generated by build_runner; rebuild on each CI run.
# Keep .freezed.dart and .g.dart files OUT of git so we never desync with
# the OpenAPI/DTO sources.
client/lib/**/*.g.dart
client/lib/**/*.freezed.dart

# =============================================================================
# Misc
# =============================================================================
program/
env.txt
openapi.json
